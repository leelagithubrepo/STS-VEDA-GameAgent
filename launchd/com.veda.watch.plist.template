<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.veda.watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PROJECT_ROOT__/scripts/veda_watch</string>
    <string>--interval</string>
    <string>20</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__PROJECT_ROOT__/artifacts/veda-watch.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT_ROOT__/artifacts/veda-watch-error.log</string>
</dict>
</plist>
