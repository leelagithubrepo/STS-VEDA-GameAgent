{
  "schema": "veda.dynamic-map-scenarios.v1",
  "purpose": "Independent, manually traced graph facts for offline route summaries; not strategic rankings or live evidence.",
  "confidence_threshold": 0.9,
  "conventions": {
    "first_nodes": "Confirmed directed outgoing neighbors of current_node_id. Compare IDs as sets; array order and ID spelling are not route preference.",
    "distance": "Minimum number of directed edges from the first node to a target, including first-node targets at distance zero. Paths for distance maps require confirmed edge and node classification evidence.",
    "target_kinds": "rest identifies a rest map node; shop explicitly normalizes to merchant. Merchant/shop/elite entries include nonempty synthetic classification_evidence.",
    "topology_only": "has_rest_path_avoiding_known_elites asks whether displayed sufficiently confident edges admit a path to rest without a known elite node, including first-node classification. Unknown kinds may occur on this topology-only path. Null means the partial graph cannot establish either existence or absence; false requires a justified negative.",
    "confirmed_elite_free": "has_confirmed_elite_free_rest_path additionally requires classified path nodes. This means no elite map NODE; a known event can still have an unknown encounter/outcome. Neither predicate means safe. The predicate is three-valued: true confirms a path, null preserves unresolved existence, and false requires confirmed impossibility.",
    "unknowns": "Empty target maps report absence of a confirmed path only. rest_reachable=null requires uncertainty, not false. Event outcomes and unclassified nodes remain distinct.",
    "resources": "Preserve supplied context. All graph expectations are invariant across resource_profiles; no affordability, healing availability, damage, reward or strategy score is inferred.",
    "invalid": "invalid_cases are separate rejection fixtures, not eligible first choices.",
    "evidence": "All nodes/edges and resources are synthetic fixtures. classification_evidence is a declared fixture label, never a real-screen observation."
  },
