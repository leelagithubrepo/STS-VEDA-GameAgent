#!/usr/bin/env python3
"""Start a fresh Luna High play session with automatic approval review."""
import argparse
import os
from pathlib import Path
import shlex
import shutil
import sqlite3
import subprocess
import sys
from uuid import UUID


def run_identity(value):
    try:
        return str(UUID(value))
    except ValueError as error:
        raise argparse.ArgumentTypeError('run ID must be a UUID') from error


def _parent_process(pid):
    """Read names only, never command arguments or unrelated process details."""
    result = subprocess.run(['/bin/ps', '-p', str(pid), '-o', 'ppid=', '-o', 'comm='],
                            capture_output=True, text=True, timeout=.2, check=False)
    fields = result.stdout.strip().split(None, 1)
    if result.returncode or len(fields) != 2:
        return None
    return int(fields[0]), fields[1]


def _nested_launch_reason():
    # Thread IDs can leak into an ordinary terminal. They alone must never
    # reject a launch. Prefer actual ancestry and stop at an interactive host.
    execution_shell = (os.environ.get('CODEX_SHELL') == '1'
                       and os.environ.get('CODEX_CI') == '1'
                       and bool(os.environ.get('CODEX_THREAD_ID') or os.environ.get('CODEX_SESSION_ID')))
    terminals = {'terminal', 'iterm', 'iterm2', 'alacritty', 'kitty', 'wezterm', 'wezterm-gui',
                 'gnome-terminal-server', 'konsole', 'login', 'sshd', 'tmux', 'screen'}
    pid, seen = os.getppid(), set()
    for _ in range(6):
        if pid <= 1 or pid in seen:
            return None
        seen.add(pid)
        try:
            process = _parent_process(pid)
        except (OSError, ValueError, subprocess.TimeoutExpired):
            break
        if process is None:
            break
        parent, executable = process
        name = Path(executable).name.casefold()
        if name in terminals or name.startswith('tmux:'):
            return None
        # The desktop app can host ordinary terminals too. Its main app
        # executable is not proof of a tool-executed Codex shell.
        if '/Contents/MacOS/' in executable and name in {'codex', 'chatgpt'}:
            return None
        if name in {'codex', 'codex.exe'}:
            return 'codex_parent_process'
        pid = parent
    # The shell tool may deny process inspection. Its combined execution-only
    # markers still identify this context; a lone inherited app/thread marker
    # is deliberately insufficient.
    return 'codex_execution_shell' if execution_shell else None


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--run-id', type=run_identity,
                        help='Resume this attempt only; otherwise identify the currently visible attempt.')
    parser.add_argument('--print-command', action='store_true',
                        help='Show the launch command without starting Codex or touching the game.')
    args = parser.parse_args()
    root = Path(__file__).resolve().parents[1]
    scope = (f'Resume only run {args.run_id}. Resolve any identity mismatch before input. '
             if args.run_id else
             'Play the currently visible Slay the Spire attempt; bind its actual identity from fresh evidence. ')
    prompt = (
        'Use $orchestrator and $spire. Read skills/orchestrator/SKILL.md '
        'from this checkout for the current play instructions. ARM ORCHESTRATOR FOR THIS RUN. '
        + scope +
        'Keep Luna High for gameplay. Check exclusive controller ownership, live game video, the ledger, '
        'pending actions and bridge readiness before arming the reviewed adapter. '
        'Use the reviewed adapter with --decision-policy learning --request-server for every input. Submit packet paths with veda_submit.py; receive the matching reply without fixed 10/30-second Terminal waits. '
        'Compact combat/menu drafts carry decision_policy:learning. Retain before/after evidence and record SQLite outcomes. '
        'Read docs/veda-play-hot-path.md, docs/veda-screen-guide.md and docs/veda-recovery-play.md first, then only the current-screen guide. Do not search source/tests to rediscover listed actions. '
        'Use the explicit /tmp/veda-ps5-bridge.sock bridge channel and docs/veda-arm-startup.md: '
        'validate the arm draft before capture, capture/stage/display together, then briefly confirm '
        'the exact inspected image and submit the ordinary arm request immediately. '
        'After arming keep playing in this turn; do not stop at an armed status or wait for continue. '
        'Use combat --last-result and compact observed results with generated paths; retain the chosen card until its effect resolves. With explicit hand focus/order/default controls use --bounded-hand for up to four direction taps and verify final focus before selection. Binding validates internally; separate validation is optional. Use compact veda_combat.py/veda_menu.py requests with --session SESSION_DIRECTORY/state.json and --execute; '
        'input epochs keep settled evidence valid during thinking, and result images do not expire just from age. '
        'Read docs/veda-evidence-continuity.md. Use veda_loot.py and docs/veda-loot-play.md for routine gold/potion '
        'collection. After a combat victory is verified on the exact settled Loot frame, go directly to veda_loot.py from that snapshot. Do not build a second combat boundary packet for routine Loot, do not reuse older reward examples. If an enabled Gold option is already focused, use the deterministic hot path: invoke veda_loot immediately with the current snapshot and --execute, without model strategy analysis, history lookup, SQLite work, or an extra focus action; then capture the actual post-collection frame and continue to the next reward. After verified gold immediately prepare the next routine reward action. For a full potion belt, make one bounded replacement choice from the named inventory; if that review reaches the 10-second watchdog, invoke the same helper with --fallback to select the visible Skip Potion once, verify the map transition, and continue. Never leave a full-belt Spoils screen waiting for another model round. '
        'The adapter already logs outcomes; defer optional reports and separate SQL work. Choose cards or skip once and retain the choice through focus/select/actual confirmation. '
        'Record acquired cards only after observing acquisition. Do not analyze old timing history between taps. Use compact result helpers; '
        'validate the draft against the exact inspected settled image and never hand-author source hashes or Reading packets. '
        'Track the persistent play clock: first verified input 90s, ordinary logical move 20s, '
        'noncombat floor 90s, combat floor 240s, elite 360s, boss 480s. Report overruns and fix the named phase; '
        'mark model reasoning as model_inference and command/capture waits as tool_wait when using the timing CLI; never call either phase during controller dispatch. '
        'Use docs/veda-handoff-priority.md as the recovery order: P0 connectivity/feed and delivery, P1 preserve/reconcile the pending action and map-to-room handoff, P2 deterministic Loot/campfire/merchant/map handlers, P2 combat focus and queued legal cards, P3 asynchronous learning telemetry. '
        'Apply the adapter watchdog signal: it starts immediately after each verified action, then refines from the next inspected request. Known fast-path screens get at most 10 seconds; ordinary combat gets 45 seconds; elite combat gets 60 seconds; boss combat gets 90 seconds; genuinely new noncombat screens get at most 45 seconds. When a watchdog_due response arrives, stop rereading the unchanged frame, choose the named safest legal fallback once, record the uncertainty and fallback in SQLite, and verify the result. For a fresh frame whose menu family differs from the pending request but the run and floor still match, reconcile the pending action exactly once with the current menu result, then plan from the current screen; never replay the old input or restart the run. Never spend repeated cycles rereading the same unchanged frame. Pause the decision budget only while a connectivity, hardware, feed, or controller-delivery check is actively running. '
        'Validate helper availability at most once per play session, cached with scripts/veda_helper_check.py HELPER --session SESSION_DIRECTORY; never repeat helper checks between routine actions. If a helper is unsupported, choose a registered helper instead of searching for or creating a new script during play. '
        'timing targets never end the run or waive source/pending-action checks. '
        'Gameplay uncertainty, missing rules, incomplete forecasts and optional potion reviews are warnings, '
        'not stop conditions. A suboptimal move or a lost run is acceptable learning. '
        'On recoverable_review stay active, repair/reobserve/re-plan and continue without asking the player. '
        'Recovery is hard-bounded by the adapter: routine 15s, combat 30s, elite 45s, boss 60s. '
        'If a response has status recovery_budget_exceeded or recovery.fallback_required=true, do not start another model round or repeat captures: perform exactly one current-screen deterministic fallback, verify it, and continue. '
        'Recovery responses classify the gap as small_variation, known_family_gap, or new_family_gap. Continue immediately for small_variation; known/new gaps are already queued in the run directory for Builder and must not block the current floor. Use the safest registered generic helper once, verify, and continue. Never wait for Builder or run development tests in the live player. '
        'Autonomous recovery is authorized for this run: first classify the failure as pre-input, '
        'post-input reconciliation, or infrastructure. For a pre-input schema/helper rejection, '
        'repair the packet source-free and retry without a new capture. For a post-input result '
        'rejection, never resend; preserve the pending action, inspect the exact after-image. '
        'If a result adapter repair is needed, stop the adapter and close the owned bridge first, confirm no input '
        'is in flight, then repair it, run focused tests, bind and verify the same action. Use finalize '
        'only for a verified_pending_log after the result is already confirmed. '
        'Do not edit product code, run tests, inspect source, or reinstall skills during an active run for a gameplay workflow mismatch. Record it in the improvement journal, use the existing generic menu/result path, and continue. Only controller, PlayStation, Remote Play, network, bridge, or feed failure may interrupt play for recovery. '
        'Do not ask the player to mediate recoverable failures. Do not repair across an unresolved '
        'controller delivery, identity mismatch, missing feed, hardware failure or network failure. '
        'Before any resume arm, run veda_submit.py --operation bridge_preflight. If it returns pending_recovered, '
        'follow its next_operation: resume_play when already armed, or run bridge_preflight once more when unarmed; '
        'this recovery never replays input. If it returns '
        'pending_reconciliation_required, preserve the action and follow its required/next_operation: when verify is '
        'requested, capture and inspect the current settled frame and write one exact verify packet; when finalize is '
        'requested, finalize the retained result without recapture. The adapter finalizes ordinary verify results; '
        'follow a returned finalize operation only when explicitly required, then follow the returned next_operation. '
        'Never arm around an attempted pending action and never create a new gameplay action to clear it. '
        'Record the reason, uncertainties, available prediction and actual outcome; retrieve relevant '
        'verified cases with veda_play_lessons.py once per encounter or new mechanic, not per focus tap. '
        'Under uncertain game state, inspect relevant facts and choose a supported move with the lowest '
        'defensible damage risk, considering lethal, block, potions and setup. '
        'For menus without a visible hint, use the applicable reviewed default-PS5 control profile in '
        'docs/veda-menu-controls.md; a missing hint alone is not a blocker. Open upgrade choices, inspect '
        'the actual cards, choose strategically, and verify the upgrade before recording it. '
        'For Rest sites use veda_campfire.py and docs/veda-campfire-play.md: choose Rest/Smith once, verify actual healing or upgrade, then return to map. At or above 75% HP with a known unupgraded Armaments, use the campfire Smith fast path and decide within 10 seconds; at or below 50% HP, use Rest unless a current-screen fact changes that risk. Use the retained observation once, not an ephemeral capture followed by another capture to archive. '
        'For merchants use docs/veda-shop-play.md and veda_shop.py, canonical session IDs, and verified result reuse. '
        'Inspect priced slots, excluding tooltip previews; SALE does not mean upgraded. Compare stock/removal/saving once, retain the choice through focus/select/confirm, and use compact shop result commands with --last-result and generated packet paths. Verify Leave then Proceed separately. '
        'Do not leave merely because navigation documentation is missing or write Python request builders during play. '
        'For maps read docs/veda-map-travel.md and use veda_map_step.py: identify the current floor\'s circled node from the HUD and canonical current-node record, not an earlier visited circle, then trace its outgoing edges and inspect immediate selectable nodes. '
        'Map caches are automatically versioned per act; use --connections for reviewed immediate edges and --reobserve-result for a corrected pending focus observation. If a selected map icon reveals a different actual noncombat room, preserve the pending activation, record the actual room, and hand off directly to its handler (Rest to veda_campfire.py, Merchant to veda_shop.py, Treasure to the treasure handler); do not keep submitting map results or restart the adapter. Future forks and the legend do not require scrolling when the current outgoing edges are readable. '
        'HARD MAP FAST PATH: when the exact current snapshot has map_siblings.complete=true, selectable_count=1, and one enabled reachable option, stop route/boss research immediately and call veda_map_step.py with that snapshot, no decision file, and --execute. Treat its fast_path decision budget as 10 seconds; do not read route caches, search boss identity, inspect future forks, or ask for another image before activation. At forks reuse the saved per-run/act route through focus taps, and verify room entry. '
        'Reassess material state changes; survey extra map only if it could change the route or boss preparation. '
        'strategy_required means choose once and continue, not stop or ask permission. '
        'Preserve uninspected inventory categories with inventory-discover. '
        'Never invent observations, replay unresolved input or bypass an adapter check. '
        'Use command-scoped automatic approval review for necessary process, network and socket checks; '
        'do not interpret a sandbox rejection as a broken bridge. Report any unresolved technical gap '
        'with the exact failed check and alternatives attempted while pursuing recovery. '
        'End at confirmed full-run victory, defeat or user stop; ordinary combat wins continue. '
        'Stop controls for actual hardware/network/bridge failure or loss of the game feed/target. '
        'Unknown action delivery needs observation and reconciliation, never blind replay.'
        ' For PlayStation power, Remote Play, network, bridge, or feed loss, preserve the pending action and run '
        'scripts/veda_recovery_watch.py in its side-band paused process; do not run probes during an ordinary move. Record '
        'the interruption/recovery JSONL, then re-preflight and resume this same run only after a fresh frame and '
        'pending-action reconciliation. Never start a new run or resend an unknown action. '
        'Combat plans may carry a bounded queue of up to eight future card/end-turn steps; execute each with the '
        'same focus/select/result verification. Promote the queue only when the next card is visible/playable, the '
        'turn and target remain valid, and no tooltip is present; otherwise clear it and request a new plan. A raised '
        'card or tooltip is occlusion evidence: do not treat visible cards as a complete hand. '
        'Read docs/veda-autonomous-recovery.md for the recovery journal and improvement checks.'
    )
    command = ['codex', '-C', str(root), '-m', 'gpt-5.6-luna',
               '-c', 'model_reasoning_effort="high"', '--approve-for-me', '--no-alt-screen', prompt]
    if args.print_command:
        print(shlex.join(command))
        return 0
    if _nested_launch_reason():
        print('This launcher is running inside an existing Codex task. No second session was started.\n'
              'The › prompt is Codex; the % or $ prompt in a Terminal tab is the shell.\n'
              'To continue this task, give it a play instruction instead of launching Orchestrator again.\n'
              'For a fresh Luna High task, first ask the current play task to stop and release its controller, '
              'then run this launcher from a new Terminal tab.', file=sys.stderr, flush=True)
        return 2
    executable = shutil.which('codex')
    if executable is None:
        parser.exit(2, 'Codex CLI was not found on PATH.\n')
    sys.path.insert(0, str(root))
    from veda.play_context import read_play_context
    from veda.play_timing import PlayTiming
    measured_run = args.run_id
    if measured_run is None:
        try:
            recorded = read_play_context(root / 'artifacts/veda-memory.sqlite3')
            if recorded.get('selection_status') == 'selected':
                # This ID selects a diagnostic clock only, never a live run or
                # controller authority. Reject malformed directory identities.
                measured_run = str(UUID(recorded['run']['id']))
            else:
                print('Startup timing unavailable: recorded run selection needs review. '
                      'Codex will identify the current run during live preflight.', file=sys.stderr, flush=True)
        except (ValueError, OSError, KeyError, TypeError, AttributeError, RuntimeError, sqlite3.Error) as error:
            measured_run = None
            print('Startup timing unavailable: recorded run selection failed '
                  f'({type(error).__name__}). Codex will still start and must verify the current run.',
                  file=sys.stderr, flush=True)
    if measured_run is not None:
        try:
            timing = PlayTiming(root / 'artifacts/reviewed-play' / measured_run / 'timing.json', run_id=measured_run)
            if timing.snapshot().get('pause') is not None:
                timing.event('resume')
            timing.event('phase', name='preflight')
        except (ValueError, OSError, KeyError, TypeError, RuntimeError) as error:
            # Timing is diagnostic. Preserve a corrupt/unavailable sidecar and
            # let the normal reviewed adapter retain all live-state checks.
            print(f'Startup timing unavailable ({type(error).__name__}). '
                  'Codex will still start; live preflight and every input check remain required.',
                  file=sys.stderr, flush=True)
    # Bind only an explicitly requested run; never inherit an unrelated old session.
    if args.run_id:
        os.environ['VEDA_PLAY_SESSION'] = str(root / 'artifacts/reviewed-play' / args.run_id)
    else:
        os.environ.pop('VEDA_PLAY_SESSION', None)
    print('Starting Luna High with automatic approval review. Game input begins only after live preflight.',
          flush=True)
    os.execv(executable, command)


if __name__ == '__main__':
    raise SystemExit(main())
